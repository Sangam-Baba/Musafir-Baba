{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "backup": "node db_backup.js",
    "restore": "node db_restore.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:b2b": "vitest run --root tests/b2b",
    "typecheck:b2b": "tsc -p src/b2b/jsconfig.json",
    "lint:b2b": "eslint -c scripts/b2b/eslint.config.js src/b2b tests/b2b scripts/b2b && prettier --config scripts/b2b/prettier.json --check \"src/b2b/**/*.js\" \"tests/b2b/**/*.js\" \"scripts/b2b/**/*.js\"",
    "format:b2b": "prettier --config scripts/b2b/prettier.json --write \"src/b2b/**/*.js\" \"tests/b2b/**/*.js\" \"scripts/b2b/**/*.js\"",
    "b2b:migrate": "node src/b2b/migrate.js",
    "b2b:guards": "node scripts/b2b/guards.js",
    "b2b:progress": "node scripts/b2b/progress.js",
    "b2b:gen-module": "node scripts/b2b/gen-module.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
