    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "ably": "^2.27.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "country-state-city": "^3.2.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.1",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "razorpay": "^2.9.6",
    "resend": "^6.0.1",
    "slugify": "^1.6.6",
    "streamifier": "^0.1.1",
    "ua-parser-js": "^2.0.6",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.17"
  },
