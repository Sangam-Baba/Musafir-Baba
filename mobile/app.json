{
  "expo": {
    "name": "mbconnect",
    "slug": "mbconnect",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/branding/drawer-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musafirbaba.mobile",
      "icon": "./assets/branding/drawer-icon.png"
    },
    "android": {
      "package": "com.musafirbaba.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/drawer-adaptive-foreground.png",
        "backgroundImage": "./assets/branding/drawer-adaptive-background.png",
        "backgroundColor": "#FD5A07"
      },
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MBConnect uses your location to confirm you've arrived at the pickup point."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "505849cb-b4a9-4244-b77b-3de309b67cb4"
      }
    },
    "owner": "jauhari001"
  }
}
